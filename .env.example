# Required at first start. Use a unique password of at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/impact_tools.db
# Optional for the Render Free trial: a PostgreSQL URL overrides DATABASE_PATH.
# Keep the real URL in the host's secret settings, never in this file or Git.
# DATABASE_URL=
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://tools.impactcircles.org

# Each tool may use a different provider and model: openai, gemini, or anthropic.
FINANCE_PROVIDER=gemini
FINANCE_MODEL=
CONTENT_PROVIDER=gemini
CONTENT_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Deploy scripts/google_apps_script/SheetsWebhook.gs and use its /exec URL.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional: an HTTPS endpoint that accepts approved content with a bearer token.
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_TOKEN=
